while True:
    items = list(vocab_theme_1a.items())
    random.shuffle(items)
    
    for i, (english, french) in enumerate(items, 1):
        # Reset and start the keep-alive thread
        stop_keepalive.clear()
        heartbeat = threading.Thread(target=keep_alive_loop, daemon=True)
        heartbeat.start()
        
        start_time = time.perf_counter()
        
        # Blocking user input call
        input(f"[{i}/{len(items)}] English: {english}\n     <Press Enter to reveal = > ")
        
        elapsed_time = time.perf_counter() - start_time
        
        # Stop the background thread immediately after user presses Enter
        stop_keepalive.set()
        heartbeat.join()
        
        print(f"\n     ---> French:  {french}")
        print(f"You took {elapsed_time:.3f} seconds.")
        print("-" * 50)
