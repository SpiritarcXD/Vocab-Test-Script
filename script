import random
import threading
import time

# Event flag to signal the background thread to stop
stop_keepalive = threading.Event()

def keep_alive_loop(interval=3):
    """Prints a keep-alive marker periodically until signaled to stop."""
    while not stop_keepalive.is_set():
        # Wait for the interval or until the stop event is set
        if stop_keepalive.wait(timeout=interval):
            break
        # Print a subtle heartbeat to keep stdout active without flooding
        print(".", end="", flush=True)

